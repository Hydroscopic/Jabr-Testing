<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>False</PublishAot>
    <SignAssembly>True</SignAssembly>
    <Title>JabrAPI</Title>
    <Version>5.5.7.1</Version>
    <Authors>Gyroscopic</Authors>
    <Description>Cryptography API for RE ciphers from the Jabr family</Description>
    <PackageProjectUrl>https://github.com/Gyroscopic-why/Jabr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Gyroscopic-why/Jabr</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>jabr;jabrapi;cryptography;ciphers;encryptor;encryption;decryption;re;re5;re4;noise;noisification;noisify;denoisify;noised</PackageTags>
    <DelaySign>False</DelaySign>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AVcontrol">
      <HintPath>..\lib\AVcontrol.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>